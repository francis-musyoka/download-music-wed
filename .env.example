PORT=4000
MUSIC_DIR=./music
PLAYLISTS_DIR=./playlists

# Disk cleanup sweeper (lib/disk-cleanup.ts). Deletes files in MUSIC_DIR and
# PLAYLISTS_DIR older than CLEANUP_MAX_AGE_DAYS, every CLEANUP_INTERVAL_HOURS.
CLEANUP_MAX_AGE_DAYS=7
CLEANUP_INTERVAL_HOURS=6

# Preview endpoint tuning. Defaults are tuned for VPS deploys (cold yt-dlp
# calls with cookies + EJS solving can take 30–60s). Values are ms; leave
# unset to accept defaults.
YT_DLP_PREVIEW_TIMEOUT_MS=60000
PREVIEW_TTL_MS=14400000
PREVIEW_SAFETY_MARGIN_MS=1800000
PREVIEW_CACHE_MAX_ENTRIES=500

# OpenAI integration
OPENAI_API_KEY=
OPENAI_ENABLED=false
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_SMART=gpt-4o
# Model used for rerank calls. Cheap default; set to gpt-4o for quality A/B.
OPENAI_MODEL_RERANK=gpt-4o-mini
OPENAI_TIMEOUT_UNDERSTAND_MS=5000
OPENAI_TIMEOUT_RERANK_MS=15000
OPENAI_BASE_URL=

# Python sidecar for ytmusicapi (scripts/ytmusic_search.py). Path to a
# python3 binary with `ytmusicapi` importable. Unset → uses python3 on PATH.
# On the VPS this points at the project venv created by Task 1.
YTMUSIC_PYTHON=

# yt-dlp cookies file. Required on datacenter IPs to avoid the
# "Sign in to confirm you're not a bot" bot-detection wall on direct
# downloads. Same file used by the preview endpoint.
YT_DLP_COOKIES=
