PORT=3000
MUSIC_DIR=./music
PLAYLISTS_DIR=./playlists

# OpenAI integration
OPENAI_API_KEY=
OPENAI_ENABLED=false
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_SMART=gpt-4o
# Model used for rerank calls. Cheap default; set to gpt-4o for quality A/B.
OPENAI_MODEL_RERANK=gpt-4o-mini
OPENAI_TIMEOUT_UNDERSTAND_MS=5000
OPENAI_TIMEOUT_RERANK_MS=15000
OPENAI_BASE_URL=
